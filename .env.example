# MySQL database URL (encode reserved characters in credentials)
DATABASE_URL="mysql://user:password@localhost:3306/portfolio"

# Random secret with at least 32 characters
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"

# Required when running `npx prisma db seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"

# Optional contact notification settings
RESEND_API_KEY=""
NOTIFICATION_RECIPIENT_EMAIL=""
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
